{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "dom",
      "dom.iterable"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/benchmark/*.bench.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "src/globals.d.ts"
  ]
}
